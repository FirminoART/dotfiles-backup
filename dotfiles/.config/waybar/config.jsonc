{
  "height": 36,
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "passthrough": false,
  "spacing": 5,
  "fixed-center": true,
  "modules-left": ["hyprland/workspaces", "tray"],
  "modules-center": ["custom/music"],
  "modules-right": [
    "pulseaudio",
    "network",
    "battery#bat1",
    "clock",
    "custom/powermenu",
  ],
  "disk": {
    "interval": 30,
    "format": "󰋊 {used}",
    "format-alt": "󰋊 {total}",
    "path": "/",
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["", ""],
  },
  "battery": {
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-alt": "{time}",
    "format-time": "{H}h {M}min",
    "format-icons": [" ", " ", " ", " ", " "],
    "max-length": 25,
  },
  "battery#bat1": {
    "bat": "BAT1",
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-full": "{icon} {capacity}%",
    "format-charging": "   {capacity}%",
    "format-plugged": "   {capacity}%",
    "format-icons": ["  ", "  ", "  ", "  ", "   "],
    "tooltip-format": "{time}",
    "interval": 1,
    "on-click": "~/Documents/Github/Linuwu-Sense-PHN16-72/tools/linuwu_sense_gui.py -p",
  },
  "network": {
    "format-wifi": "   {essid} ({signalStrength}%)",
    "format-ethernet": "󰈀  Connected",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "format-linked": " {ifname} (No IP)",
    "format-disconnected": "  Disconnected",
    "on-click": "foot -e sh -c 'sleep 0.01 && nmtui'",
    "max-length": 50,
  },
  "custom/logo": {
    "format": "  󰣇",
    "on-click": "fuzzel",
    "tooltip": false,
  },
  "custom/micro": {
    "exec": "sleep 0.1 && ~/.config/waybar/micro.sh",
    "restart-interval": 1,
    "on-click": "~/.config/waybar/micro1.sh",
    "tooltip": false,
  },
  "custom/powermenu": {
    "format": "⏻",
    "on-click": "/home/felipe/.config/hypr/powermenu.sh",
    "tooltip": false,
  },
  "custom/swaync": {
    "format": "󰂚",
    "on-click": "swaync-client -t",
    "tooltip": false,
  },
  "custom/weather": {
    "format": "{}",
    "interval": 10,
    "exec": "~/.config/waybar/weather.sh",
    "tooltip": false,
  },
  "custom/music": {
    "max-length": 64,
    "format": "{}",
    "interval": 1,
    "exec": "playerctl metadata --format '󰎈  {{title}} - {{artist}}'",
    "tooltip": false,
  },
  "custom/date": {
    "format": "{}",
    "exec": " date +'󰃭 %a %d %b' ",
    "tooltip": false,
  },
  "tray": {
    "icon-size": 18,
    "spacing": 9,
  },
  "clock": {
    "format": "   {:%I:%M %p}",
    "format-alt": "󰃭  {:%d/%m/%Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon}  {volume}% ",
    "format-bluetooth-muted": " {icon} ",
    "format-muted": "󰝟   Muted",
    "format-icons": {
      "headphone": "  ",
      "hands-free": "",
      "headset": "",
      "phone": " ",
      "portable": " ",
      "car": "" ,
      "default": ["  ", "  ", "  "],
    },
    "on-click": "pavucontrol",
    "on-click-right": "pavucontrol",
    "tooltip": false,
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 60,
  },
  "hyprland/language": {
    "format": "{}",
    "format-en": "en",
    "format-ru": "ru",
    "on-click": "hyprctl switchxkblayout company--usb-device- next",
  },
  "hyprland/workspaces": {
    "format": "<span font='11'>{name}</span>",
    "on-click": "activate",
    "sort-by-number": true,
  },
  "custom/cava": {
    "exec": "cava -p ~/.config/cava/config1 | sed -u 's/;//g;s/0/▁/g;s/1/▂/g;s/2/▃/g;s/3/▄/g;s/4/▅/g;s/5/▆/g;s/6/▇/g;s/7/█/g;'",
    "tooltip": false,
  },
  "custom/mako": {
    "exec": "~/.config/hypr/scripts/check_mako_mode.sh",
    "on-click": "~/.config/hypr/scripts/do-not-disturb.sh",
    "restart-interval": 1,
    "tooltip": false,
  },
}
